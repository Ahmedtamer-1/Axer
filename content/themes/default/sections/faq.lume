<div class="section" style="max-width: 760px; margin: 0 auto; padding: 3rem 1.5rem;">
    {% if title %}
        <h2 style="text-align: center; font-size: 2rem; margin-bottom: 2rem; color: var(--text-color);">{{ title }}</h2>
    {% endif %}

    {% if q1 %}
        <div style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 0;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-color);">{{ q1 }}</h3>
            <p style="color: var(--text-muted); line-height: 1.6;">{{ a1 }}</p>
        </div>
    {% endif %}
    {% if q2 %}
        <div style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 0;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-color);">{{ q2 }}</h3>
            <p style="color: var(--text-muted); line-height: 1.6;">{{ a2 }}</p>
        </div>
    {% endif %}
    {% if q3 %}
        <div style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 0;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-color);">{{ q3 }}</h3>
            <p style="color: var(--text-muted); line-height: 1.6;">{{ a3 }}</p>
        </div>
    {% endif %}
</div>
