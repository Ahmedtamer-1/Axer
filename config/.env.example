# Copy this file to config/.env and fill in real values.
# config/.env must NEVER be committed — it is listed in .gitignore.

# "production" or "local". Controls error verbosity defaults.
APP_ENV=production

# Show stack traces in the browser. MUST be false in production:
# traces include database credentials and file paths.
APP_DEBUG=false

# 64-char random hex. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Base URL used to build absolute links (no trailing slash).
APP_URL=https://example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
