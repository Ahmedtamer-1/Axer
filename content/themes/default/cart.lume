<div style="max-width: 900px; margin: 2rem auto;">
    <div style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between;">
        <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--text-color);">Your Shopping Cart</h1>
        <a href="/shop" class="btn btn-secondary"><i data-lucide="arrow-left"></i> Continue Shopping</a>
    </div>

    {% if is_empty %}
        <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 1rem; padding: 4rem 2rem; text-align: center; color: var(--text-muted);">
            <i data-lucide="shopping-bag" style="width: 54px; height: 54px; color: var(--primary); margin-bottom: 1rem; opacity: 0.8;"></i>
            <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-color); margin-bottom: 0.5rem;">Your cart is currently empty</h2>
            <p style="margin-bottom: 2rem;">Explore our store to add items to your cart.</p>
            <a href="/shop" class="btn btn-primary" style="padding: 0.85rem 2rem;">Start Shopping</a>
        </div>
    {% else %}
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
            <!-- Cart Items List -->
            <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 1rem; padding: 1.5rem;">
                {% for item in cart_items %}
                    <div style="display: flex; gap: 1.25rem; align-items: center; padding: 1rem 0; border-bottom: 1px solid #f1f5f9;">
                        <img src="{{ item.image_url }}" style="width: 70px; height: 70px; object-fit: cover; border-radius: 0.5rem; background: #f1f5f9;">
                        
                        <div style="flex-grow: 1;">
                            <a href="/products/{{ item.slug }}" style="font-weight: 700; color: var(--text-color); text-decoration: none; font-size: 1.05rem;">
                                {{ item.name }}
                            </a>
                            {% if item.variant_name %}
                                <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.15rem;">{{ item.variant_name }}</div>
                            {% endif %}
                            <div style="font-weight: 700; color: var(--primary); margin-top: 0.35rem;">EGP {{ item.price }}</div>
                        </div>

                        <!-- Quantity Selector -->
                        <form action="/cart/update" method="POST" style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="key" value="{{ item.key }}">
                            <input type="number" name="quantity" value="{{ item.quantity }}" min="1" max="99" style="width: 60px; padding: 0.4rem; border-radius: 0.375rem; border: 1px solid var(--border-color); text-align: center;" onchange="this.form.submit()">
                        </form>

                        <!-- Remove Button -->
                        <form action="/cart/remove" method="POST">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="key" value="{{ item.key }}">
                            <button type="submit" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0.5rem;" title="Remove Item">
                                <i data-lucide="trash-2" style="width: 18px; height: 18px;"></i>
                            </button>
                        </form>
                    </div>
                {% endfor %}
            </div>

            <!-- Summary Card -->
            <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 1rem; padding: 1.5rem; height: fit-content;">
                <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem;">Order Summary</h3>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem;">
                    <span style="color: var(--text-muted);">Subtotal</span>
                    <span style="font-weight: 600;">EGP {{ cart_total }}</span>
                </div>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 1.25rem; font-size: 0.95rem;">
                    <span style="color: var(--text-muted);">Shipping</span>
                    <span style="color: #10b981; font-weight: 600;">Calculated at checkout</span>
                </div>

                <div style="border-top: 1px solid var(--border-color); padding-top: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 1.1rem; font-weight: 700;">Total</span>
                    <span style="font-size: 1.5rem; font-weight: 800; color: var(--primary);">EGP {{ cart_total }}</span>
                </div>

                <form action="/checkout/process" method="POST">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.95rem; font-size: 1.05rem;">
                        Proceed to Checkout <i data-lucide="arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    {% endif %}
</div>
