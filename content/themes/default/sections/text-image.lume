<div class="section text-image-section" style="background-color: {{ bg_color | default('#ffffff') }}; color: {{ text_color | default('#0f172a') }}; padding: 4rem 2rem;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: {% if image_position == 'left' %}row-reverse{% else %}row{% endif %}; gap: 3rem; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 300px;">
            <h2 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 1rem; line-height: 1.2;">{{ title }}</h2>
            <p style="font-size: 1.125rem; line-height: 1.7; color: var(--text-muted);">{{ content }}</p>
        </div>
        <div style="flex: 1; min-width: 300px; max-height: 520px; overflow: hidden; border-radius: 1rem;">
            <img src="{{ image_url }}" alt="{{ title }}" style="width: 100%; height: 100%; max-height: 520px; object-fit: cover; border-radius: 1rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
        </div>
    </div>
</div>
