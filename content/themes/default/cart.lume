<style>
    .cart-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start; }
    .cart-panel {
        background: #fff; border: 1px solid var(--border-color);
        border-radius: 1rem; padding: 1.5rem;
    }
    .cart-line {
        display: grid;
        grid-template-columns: 70px 1fr auto auto;
        gap: 1.25rem; align-items: center;
        padding: 1rem 0; border-bottom: 1px solid #f1f5f9;
    }
    .cart-line:last-child { border-bottom: none; }
    .cart-thumb {
        width: 70px; height: 70px; object-fit: cover;
        border-radius: 0.5rem; background: #f1f5f9;
    }
    .cart-qty {
        width: 68px; padding: 0.45rem; border-radius: 0.375rem;
        border: 1px solid var(--border-color); text-align: center; font: inherit;
    }
    .icon-button {
        background: none; border: none; color: var(--text-muted);
        cursor: pointer; padding: 0.5rem; border-radius: 0.375rem;
    }
    .icon-button:hover { color: #ef4444; background: #fef2f2; }
    .summary-row {
        display: flex; justify-content: space-between;
        margin-bottom: 0.75rem; font-size: 0.95rem;
    }
    .summary-total {
        border-top: 1px solid var(--border-color); padding-top: 1rem;
        margin: 1rem 0 1.5rem; display: flex;
        justify-content: space-between; align-items: center;
    }
    .field { margin-bottom: 0.875rem; }
    .field label {
        display: block; font-size: 0.85rem; font-weight: 600;
        margin-bottom: 0.3rem; color: var(--text-color);
    }
    .field input, .field textarea {
        width: 100%; padding: 0.6rem 0.75rem; font: inherit; font-size: 1rem;
        border: 1px solid var(--border-color); border-radius: 0.5rem;
        background: #fff; color: var(--text-color);
    }
    .field input:focus, .field textarea:focus {
        outline: none; border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
    }
    .shipping-nudge {
        background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534;
        border-radius: 0.5rem; padding: 0.7rem 0.9rem;
        font-size: 0.85rem; margin-bottom: 1rem;
    }

    @media (max-width: 860px) {
        .cart-layout { grid-template-columns: 1fr; }
        /* Stack each line so a 4-column grid does not overflow on a phone. */
        .cart-line {
            grid-template-columns: 64px 1fr auto;
            grid-template-areas: "img info remove" "img qty qty";
            row-gap: 0.6rem;
        }
        .cart-thumb { grid-area: img; width: 64px; height: 64px; }
        .cart-info { grid-area: info; }
        .cart-qty-form { grid-area: qty; }
        .cart-remove-form { grid-area: remove; }
    }
</style>

<div style="max-width: 960px; margin: 2rem auto;">
    <div style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--text-color);">Your Shopping Cart</h1>
        <a href="/shop" class="btn btn-secondary"><i data-lucide="arrow-left"></i> Continue Shopping</a>
    </div>

    {% if is_empty %}
        <div class="cart-panel" style="padding: 4rem 2rem; text-align: center; color: var(--text-muted);">
            <i data-lucide="shopping-bag" style="width: 54px; height: 54px; color: var(--primary); margin-bottom: 1rem; opacity: 0.8;"></i>
            <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-color); margin-bottom: 0.5rem;">Your cart is currently empty</h2>
            <p style="margin-bottom: 2rem;">Explore our store to add items to your cart.</p>
            <a href="/shop" class="btn btn-primary" style="padding: 0.85rem 2rem;">Start Shopping</a>
        </div>
    {% else %}
        <div class="cart-layout">
            <!-- Cart Items List -->
            <div class="cart-panel">
                {% for item in cart_items %}
                    <div class="cart-line">
                        <img src="{{ item.image_url }}" alt="{{ item.name }}" class="cart-thumb" loading="lazy" width="70" height="70">

                        <div class="cart-info">
                            <a href="/products/{{ item.slug }}" style="font-weight: 700; color: var(--text-color); text-decoration: none; font-size: 1.05rem;">
                                {{ item.name }}
                            </a>
                            {% if item.variant_name %}
                                <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.15rem;">{{ item.variant_name }}</div>
                            {% endif %}
                            <div style="font-weight: 700; color: var(--primary); margin-top: 0.35rem;">
                                EGP {{ item.formatted_price }}
                            </div>
                        </div>

                        <!-- Quantity -->
                        <form action="/cart/update" method="POST" class="cart-qty-form" data-no-busy>
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="key" value="{{ item.key }}">
                            <label for="qty-{{ item.key }}" class="visually-hidden" style="position:absolute;left:-9999px;">
                                Quantity for {{ item.name }}
                            </label>
                            <input id="qty-{{ item.key }}" class="cart-qty" type="number" name="quantity"
                                   value="{{ item.quantity }}" min="1" max="99" data-auto-submit>
                        </form>

                        <!-- Remove -->
                        <form action="/cart/remove" method="POST" class="cart-remove-form">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="key" value="{{ item.key }}">
                            <button type="submit" class="icon-button" title="Remove {{ item.name }}" aria-label="Remove {{ item.name }}">
                                <i data-lucide="trash-2" style="width: 18px; height: 18px;"></i>
                            </button>
                        </form>
                    </div>
                {% endfor %}
            </div>

            <!-- Summary + checkout details -->
            <div class="cart-panel">
                <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem;">
                    Order Summary
                </h2>

                {% if free_shipping_remaining %}
                    <div class="shipping-nudge">
                        Add <strong>EGP {{ free_shipping_remaining }}</strong> more to qualify for free delivery.
                    </div>
                {% endif %}

                <div class="summary-row">
                    <span style="color: var(--text-muted);">Subtotal</span>
                    <span style="font-weight: 600;">EGP {{ cart_subtotal }}</span>
                </div>

                <div class="summary-row">
                    <span style="color: var(--text-muted);">Shipping</span>
                    <span style="font-weight: 600;">{{ cart_shipping }}</span>
                </div>

                <div class="summary-total">
                    <span style="font-size: 1.1rem; font-weight: 700;">Total</span>
                    <span style="font-size: 1.5rem; font-weight: 800; color: var(--primary);">EGP {{ cart_total }}</span>
                </div>

                <!--
                    Delivery details.

                    This form used to submit nothing but the CSRF token, and
                    the controller took the charge amount from the request
                    body. Every order was recorded as "Guest" with a
                    placeholder email and phone number, and the total is now
                    always recalculated on the server.
                -->
                <form action="/checkout/process" method="POST">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">

                    <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.875rem;">Delivery details</h3>

                    <div class="field">
                        <label for="co-name">Full name</label>
                        <input id="co-name" name="name" type="text" required autocomplete="name" maxlength="200">
                    </div>

                    <div class="field">
                        <label for="co-email">Email</label>
                        <input id="co-email" name="email" type="email" required autocomplete="email" maxlength="255">
                    </div>

                    <div class="field">
                        <label for="co-phone">Phone</label>
                        <input id="co-phone" name="phone" type="tel" required autocomplete="tel"
                               inputmode="tel" maxlength="20" placeholder="01xxxxxxxxx">
                    </div>

                    <div class="field">
                        <label for="co-address">Delivery address</label>
                        <textarea id="co-address" name="address" rows="2" required
                                  autocomplete="street-address" maxlength="500"></textarea>
                    </div>

                    <div class="field">
                        <label for="co-city">City</label>
                        <input id="co-city" name="city" type="text" value="Cairo"
                               autocomplete="address-level2" maxlength="100">
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.95rem; font-size: 1.05rem; margin-top: 0.5rem;">
                        Proceed to Checkout <i data-lucide="arrow-right"></i>
                    </button>

                    <p style="font-size: 0.78rem; color: var(--text-muted); text-align: center; margin-top: 0.75rem;">
                        You will be redirected to our secure payment provider.
                    </p>
                </form>
            </div>
        </div>
    {% endif %}
</div>
