<div class="section" style="background: var(--secondary); color: #fff; text-align: center; padding: 4rem 2rem; border-radius: 1rem; margin: 3rem 0;">
    <h2 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.75rem; color: #fff;">{{ title | default('Ready to get started?') }}</h2>
    <p style="font-size: 1.1rem; opacity: 0.85; margin-bottom: 2rem;">{{ subtitle | default('') }}</p>
    <a href="{{ button_url | default('/shop') }}" class="btn btn-primary" style="padding: 0.9rem 2.25rem; display: inline-block;">
        {{ button_text | default('Shop Now') }}
    </a>
</div>
