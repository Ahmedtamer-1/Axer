<div class="hero-section" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #ffffff; text-align: center; padding: 5rem 2rem; border-radius: 1.25rem; margin-bottom: 3.5rem; box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.3);">
    <span style="display: inline-block; padding: 0.35rem 1rem; border-radius: 9999px; background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.5rem;">Next-Gen E-Commerce</span>
    <h1 style="font-size: 3.5rem; font-weight: 800; margin-bottom: 1.25rem; line-height: 1.15; letter-spacing: -0.025em; color: #ffffff;">Welcome to Axer Storefront</h1>
    <p style="font-size: 1.25rem; opacity: 0.95; max-width: 650px; margin: 0 auto 2.25rem; font-weight: 400; line-height: 1.6;">
