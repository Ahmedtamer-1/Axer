<div class="section container">
    {% if title %}
        <div class="section-heading">
            <span class="eyebrow">Gallery</span>
            <h2>{{ title }}</h2>
        </div>
    {% endif %}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
        {% if image_1 %}
            <div style="aspect-ratio: 1/1; background: #ede2d2; overflow: hidden;">
                <img src="{{ image_1 }}" alt="" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
        {% endif %}
        {% if image_2 %}
            <div style="aspect-ratio: 1/1; background: #ede2d2; overflow: hidden;">
                <img src="{{ image_2 }}" alt="" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
        {% endif %}
        {% if image_3 %}
            <div style="aspect-ratio: 1/1; background: #ede2d2; overflow: hidden;">
                <img src="{{ image_3 }}" alt="" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
        {% endif %}
        {% if image_4 %}
            <div style="aspect-ratio: 1/1; background: #ede2d2; overflow: hidden;">
                <img src="{{ image_4 }}" alt="" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
        {% endif %}
    </div>
</div>
