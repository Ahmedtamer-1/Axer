<div style="max-width: 640px; margin: 4rem auto; padding: 0 1.5rem;">
    <div style="background: var(--bg-color); border: 1px solid var(--border-color); border-radius: var(--radius); padding: 2.5rem;">
        <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-color); margin: 0 0 0.5rem;">My Account</h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0 0 2rem;">Signed in as {{ account.email }}.</p>

        <div style="display: grid; gap: 0.75rem; margin-bottom: 2rem;">
            <div style="display: flex; justify-content: space-between; padding: 0.875rem 0; border-bottom: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); font-size: 0.9rem;">Name</span>
                <span style="color: var(--text-color); font-weight: 600;">{{ account.name }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 0.875rem 0; border-bottom: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); font-size: 0.9rem;">Email</span>
                <span style="color: var(--text-color); font-weight: 600;">{{ account.email }}</span>
            </div>
        </div>

        <div style="display: flex; gap: 1rem;">
            <a href="/products" class="btn btn-secondary" style="text-decoration: none; text-align: center; flex: 1;">Continue Shopping</a>
            <a href="/account/logout" class="btn btn-primary" style="text-decoration: none; text-align: center; flex: 1;">Sign Out</a>
        </div>
    </div>
</div>
