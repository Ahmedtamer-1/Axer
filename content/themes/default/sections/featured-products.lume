<div style="margin-bottom: 4rem;">
    <div style="text-align: center; margin-bottom: 2.5rem;">
        <h2 style="font-size: 2.25rem; font-weight: 800; color: var(--text-color); margin-bottom: 0.5rem; letter-spacing: -0.025em;">Featured Collections</h2>
        <p style="color: var(--text-muted); font-size: 1.05rem;">Discover our handpicked selection of top quality items.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        <?php
        $featuredProducts = \Axer\Database\QueryBuilder::table('products')
            ->where('status', 'active')
            ->limit(4)
            ->get();

        if (empty($featuredProducts)):
        ?>
            <div style="grid-column: 1 / -1; text-align: center; padding: 3rem; background: #f8fafc; border-radius: 1rem; color: var(--text-muted);">
                <p style="font-size: 1.1rem; margin-bottom: 1rem;">No products added yet.</p>
                <a href="/admin/products" class="btn btn-primary" style="font-size: 0.9rem;">Add Products in Admin</a>
            </div>
        <?php else: ?>
            <?php foreach ($featuredProducts as $fp): 
                $img = \Axer\Database\QueryBuilder::table('product_images')->where('product_id', $fp['id'])->first();
                $imgUrl = $img ? $img['url'] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80';
            ?>
                <div class="product-card" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 1rem; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s; box-shadow: var(--shadow-sm);">
                    <div>
                        <a href="/products/<?= htmlspecialchars($fp['slug']) ?>" style="text-decoration: none; color: inherit; display: block;">
                            <div style="width: 100%; aspect-ratio: 1/1; border-radius: 0.75rem; background: #f1f5f9; overflow: hidden; margin-bottom: 1.25rem; position: relative;">
                                <img src="<?= htmlspecialchars($imgUrl) ?>" alt="<?= htmlspecialchars($fp['name']) ?>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;">
                            </div>
                            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--text-color);"><?= htmlspecialchars($fp['name']) ?></h3>
                            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.4; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                <?= htmlspecialchars(strip_tags($fp['description'] ?? '')) ?>
                            </p>
                        </a>
                    </div>
                    
                    <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #f1f5f9; padding-top: 1rem; margin-top: 0.5rem;">
                        <span style="font-size: 1.25rem; font-weight: 800; color: var(--primary);">
                            EGP <?= number_format((float)$fp['price'], 2) ?>
                        </span>
                        
                        <form action="/cart/add" method="POST" style="margin: 0;">
                            <input type="hidden" name="_csrf" value="<?= $_SESSION['csrf_token'] ?? '' ?>">
                            <input type="hidden" name="product_id" value="<?= $fp['id'] ?>">
                            <button type="submit" class="btn btn-secondary" style="padding: 0.5rem 0.85rem; font-size: 0.85rem; border-radius: 0.5rem;">
                                <i data-lucide="shopping-cart" style="width: 16px; height: 16px;"></i> Add
                            </button>
                        </form>
                    </div>
                </div>
            <?php endforeach; ?>
        <?php endif; ?>
    </div>
</div>
